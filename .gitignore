# ============================================================================
# 1. SYSTEM & GLOBAL IGNORES
# ============================================================================

# --- OS-Specific Junk ---
.DS_Store
**/.DS_Store
.AppleDouble
._*
.Trash
.Trashes
Thumbs.db
saved_macos_defaults.plist

# --- Large Personal Data Directories ($HOME) ---
Applications/
Desktop/
Documents/
Downloads/
Library/
Movies/
Music/
Pictures/
Public/

# --- Shell History & Sessions ---
.bash_history
.zsh_history
.history
.netrwhist
.psysh/
.zcompdump*

# ============================================================================
# 2. SECURITY & SECRETS (CRITICAL)
# ============================================================================

# --- Environment Files ---
.env
.env*
!.env.example
*.env
.env.backup
.env.production
.envrc

# --- Keys, Certificates, & Auth ---
*.key
*.pem
/auth.json
.secrets

# --- Application Specific Secrets ---
.config/.semgrep/settings.yml
.config/clara/ollama/id_ed25519
.config/claude/claude.json
.config/claude/claude.json.backup
.config/goose/config.yaml*
.config/raycast/config.json*

# ============================================================================
# 3. DOTFILE MANAGEMENT
# ============================================================================

# --- Chezmoi Internal ---
.config/chezmoi
.local/share/chezmoi

# --- Legacy/Stow ---
dotfiles*

# ============================================================================
# 4. EDITORS & IDE CONFIGURATION
# ============================================================================

# --- JetBrains (IntelliJ, PyCharm, etc) ---
.idea/
*.iml
.config/idea/

# --- VS Code / Cursor ---
.vscode/
.cursor/
.config/vscode/
.config/vscode-insiders/
.config/cursor/
*.code-workspace

# --- Fleet, Zed, Nova ---
.fleet/
.zed/
.nova/
.config/zed/

# --- Vim / Neovim ---
*~
*.swp
*.swo
*.swn
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]*.un~
**/vim/undodir/*
Session.vim

# --- Emacs ---
\#*\#
.\#*
*.elc
emacs/.local/straight/

# --- Editor Backups ---
*.bak
*.tmp
*.orig

