		-
			rawMessage: 'Dynamic call to static method App\Models\Builders\TeamBuilder<App\Models\Team>::whereNull().'
			identifier: staticMethod.dynamicCall
			count: 1
			path: app/Support/Validation/TeamNameValidator.php

		-
			rawMessage: 'Dynamic call to static method Illuminate\Database\Eloquent\Builder<Illuminate\Database\Eloquent\Model>::exists().'
			identifier: staticMethod.dynamicCall
			count: 1
			path: app/Support/Validation/TeamNameValidator.php

		-
			rawMessage: 'Dynamic call to static method Illuminate\Database\Eloquent\Builder<Illuminate\Database\Eloquent\Model>::orWhereJsonContains().'
			identifier: staticMethod.dynamicCall
			count: 1
			path: app/Support/Validation/TeamNameValidator.php

		-
			rawMessage: 'Method App\Support\Validation\TeamNameValidator::applyArrayNameConstraints() has parameter $query with generic class Illuminate\Database\Eloquent\Builder but does not specify its types: TModel'
			identifier: missingType.generics
			count: 1
			path: app/Support/Validation/TeamNameValidator.php

		-
			rawMessage: 'Method App\Support\Validation\TeamNameValidator::applyStringNameConstraints() has parameter $query with generic class Illuminate\Database\Eloquent\Builder but does not specify its types: TModel'
			identifier: missingType.generics
