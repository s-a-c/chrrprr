{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build 2>&1",
        "dev": "bun --bun vite",
        "lint": "bunx @biomejs/biome check resources/ 2>&1",
        "lintfix": "bunx @biomejs/biome check --write resources/ 2>&1",
        "playwright:install": "bunx playwright install --with-deps 2>&1",
        "preview": "vite preview 2>&1",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:browser": "bunx playwright test 2>&1"
    },
    "dependencies": {
        "@catppuccin/highlightjs": "^1.0.1",
        "@tailwindcss/typography": "^0.5.19",
        "autoprefixer": "^10.4.23",
        "axios": "^1.13.2",
        "highlight.js": "^11.11.1",
        "laravel-echo": "^2.2.7",
        "pusher-js": "^8.4.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.10",
        "@catppuccin/tailwindcss": "^1.0.0",
        "@codecov/rollup-plugin": "^1.9.1",
        "@codecov/vite-plugin": "^1.9.1",
        "@tailwindcss/vite": "^4.1.18",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/user-event": "^14.6.1",
        "@vitest/coverage-v8": "^4.0.16",
        "@vitest/ui": "^4.0.16",
        "bun-git-hooks": "^0.3.1",
        "bun-plugin-tailwind": "^0.1.2",
        "concurrently": "^9.2.1",
        "glob": "^13.0.0",
        "happy-dom": "^20.0.11",
        "jsdom": "^27.4.0",
        "laravel-vite-plugin": "^2.0.1",
        "npm-check-updates": "^19.2.0",
        "playwright": "^1.57.0",
        "rolldown-vite": "^7.3.0",
        "tailwindcss": "^4.1.18",
        "vite": "^7.3.0",
        "vitest": "^4.0.16"
    },
    "engines": {
        "bun": ">=1.3.0",
        "node": ">=24"
    },
    "packageManager": "bun@latest",
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.54.0",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.1.18",
        "lightningcss-linux-x64-gnu": "^1.30.2"
    }
}
