        "laravel/tinker": "^2.11.0",
        "livewire/flux": "^2.10.2",
        "livewire/flux-pro": "^2.10.2",
        "livewire/livewire": "^4.0",
        "pusher/pusher-php-server": "^7.2.7",
        "spatie/laravel-activitylog": "^4.10.2",
        "spatie/laravel-comments": "^2.3",
