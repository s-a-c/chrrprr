    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.fluxui.dev",
            "name": "flux-pro"
        },
        {
            "type": "vcs",
            "url": "https://github.com/s-a-c/filament-shield",
            "name": "filament-shield"
        },
        {
            "type": "composer",
            "url": "https://composer.fluxui.dev",
            "name": "fluxui-pro"
        },
        {
            "type": "vcs",
            "url": "https://github.com/s-a-c/laravel-comments-livewire",
            "name": "laravel-comments-livewire"
        },
        {
            "type": "composer",
            "url": "https://satis.spatie.be",
            "name": "laravel-comments"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laravel-labs/starter-kit-browser-tests",
            "name": "laravel-labs-starter-kit-browser-tests"
        },
        {
            "type": "path",
            "url": "/Users/s-a-c/nc/Projects/Git/s-a-c/laravel-shiki-bridge",
            "name": "laravel-shiki-bridge"
        },
        {
            "type": "vcs",
            "url": "https://github.com/s-a-c/psalm-plugin-laravel",
            "name": "psalm-plugin-laravel"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 3600,
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "12.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "analyze": [
            "@cache:clear",
            "composer normalize",
            "@analyze:mago",
            "@analyze:phpstan",
            "@analyze:psalm",
            "@analyze:psalm:stats"
        ],
        "analyze:fix": [
            "@cache:clear",
            "composer normalize",
            "@analyze:fix:mago",
            "@analyze:fix:phpstan",
            "@analyze:fix:psalm",
            "@analyze:psalm:stats"
        ],
        "analyze:fix:mago": [
            "@banner \"Mago Types Fix\" \"1;32\"",
            "@php -r '$m = shell_exec(\"command -v mago 2>/dev/null\") ?: \"/usr/local/bin/mago\"; if (is_executable($m)) passthru(\"$m analyze --fix --baseline mago-analysis-baseline.toml 2>/dev/null\"); else printf(\"Skipping mago analyze --fix (not found)\\n\");' "
        ],
        "analyze:fix:phpstan": [
            "@banner \"PHPStan Fix\" \"1;94\"",
            "@php vendor/bin/phpstan analyse --fix || true"
        ],
        "analyze:fix:psalm": [
            "@banner \"Psalm Alter\" \"1;95\"",
            "@php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" vendor/bin/psalm --no-cache --threads=1 --alter --issues=all || true"
        ],
        "analyze:mago": [
            "@banner \"Mago Types\" \"1;96\"",
            "@php -r '$m = shell_exec(\"command -v mago 2>/dev/null\") ?: \"/usr/local/bin/mago\"; if (is_executable($m)) passthru(\"$m analyze --baseline mago-analysis-baseline.toml 2>/dev/null\"); else printf(\"Skipping mago analyze (not found)\\n\");' "
        ],
        "analyze:phpstan": [
            "@banner \"PHPStan\" \"1;91\"",
            "@php vendor/bin/phpstan analyse"
        ],
        "analyze:psalm": [
            "@banner \"Psalm\" \"1;95\"",
            "@php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" vendor/bin/psalm --no-cache --threads=1"
        ],
        "analyze:psalm:stats": [
            "@banner \"Psalm Stats\" \"1;93\"",
            "@php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" vendor/bin/psalm --no-cache --show-info=true --stats"
        ],
        "banner": [
            "@php -r 'require \"vendor/autoload.php\"; App\\Support\\Console\\Banner::display(array_slice($argv, 1));' -- "
        ],
        "behat:all": [
            "@behat:unit",
            "@behat:api",
            "@behat:browser"
        ],
        "behat:api": [
            "@banner \"Behat API Tests\" \"1;34\"",
            "@php vendor/bin/behat --config=behat.yml --suite=api"
        ],
        "behat:browser": [
            "@banner \"Behat Browser Tests\" \"1;35\"",
            "@php vendor/bin/behat --config=behat.yml --suite=browser"
        ],
        "behat:unit": [
            "@banner \"Behat Unit Tests\" \"1;33\"",
            "@php vendor/bin/behat --config=behat.yml --suite=unit"
        ],
        "blueprint:build": [
            "@banner \"Blueprint Build\" \"1;94\"",
            "php artisan blueprint:build"
        ],
        "blueprint:trace": [
            "@banner \"Blueprint Trace\" \"1;92\"",
            "php artisan blueprint:trace"
        ],
        "cache:clear": [
            "@banner \"Cache Clear\" \"1;90\"",
            "@cache:clear:phpstan",
            "@cache:clear:psalm",
            "@cache:clear:rector",
            "@cache:clear:pest",
            "@cache:clear:laravel",
            "@cache:clear:views",
            "@log \"✓ All caches cleared successfully\" \"0;32\""
        ],
        "cache:clear:all": [
            "@banner \"Deep Clean\" \"1;90;41\"",
            "@cache:clear",
            "@cache:clear:tmp",
            "@log \"✓ Deep clean complete\" \"0;32\""
        ],
        "cache:clear:laravel": [
            "@log \"Clearing Laravel cache...\" \"0;36\"",
            "php artisan optimize:clear --ansi 2>/dev/null || true"
        ],
        "cache:clear:pest": [
            "@log \"Clearing Pest cache...\" \"0;36\"",
            "@php -r 'array_map(\"unlink\", glob(\".phpunit.result.cache\")); if(is_dir(\".phpunit.cache\")) passthru(\"rm -rf .phpunit.cache\"); if(is_dir(\".pest.cache\")) passthru(\"rm -rf .pest.cache\");' "
        ],
        "cache:clear:phpstan": [
            "@log \"Clearing PHPStan cache...\" \"0;36\"",
            "rm -rf tmp/phpstan 2>/dev/null || true"
        ],
        "cache:clear:psalm": [
            "@log \"Clearing Psalm cache...\" \"0;36\"",
            "rm -rf tmp/psalm 2>/dev/null || true"
        ],
        "cache:clear:rector": [
            "@log \"Clearing Rector cache...\" \"0;36\"",
            "rm -rf tmp/rector 2>/dev/null || true"
        ],
        "cache:clear:tmp": [
            "@log \"Clearing temporary files...\" \"0;36\"",
            "find tmp -type f -delete 2>/dev/null || true"
        ],
        "cache:clear:views": [
            "@log \"Clearing compiled views...\" \"0;36\"",
            "rm -rf storage/framework/views/* 2>/dev/null || true"
        ],
        "ci:local": [
            "@banner \"CI Local\" \"1;94\"",
            "@ci:local:lint",
            "@ci:local:tests",
            "@ci:local:browser-tests",
            "@ci:local:pre-commit"
        ],
        "ci:local:browser-tests": [
            "@banner \"CI Local Browser-Tests\" \"1;31\"",
            "act -W .github/workflows/browser-tests.yml"
        ],
        "ci:local:lint": [
            "@banner \"CI Local Lint\" \"1;36\"",
            "act -W .github/workflows/lint.yml"
        ],
        "ci:local:nightlu-heavy": [
            "@banner \"CI Local Heavy\" \"1;35\"",
            "act -W .github/workflows/nightly-heavy.yml"
        ],
        "ci:local:pre-commit": [
            "@banner \"CI Local Pre-Commit\" \"1;32\"",
            "act -W .github/workflows/pre-commit.yml"
        ],
        "ci:local:tests": [
            "@banner \"CI Local Tests\" \"1;94\"",
            "act -W .github/workflows/tests.yml"
        ],
        "dev": [
            "@banner \"Dev Server\" \"1;96;47\"",
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:solo": [
            "@banner \"Dev Server (Solo)\" \"1;95;47\"",
            "Composer\\Config::disableProcessTimeout",
            "php artisan solo"
        ],
        "ide-helper:generate": [
            "@banner \"IDE Helper\" \"1;93\"",
            "php artisan ide-helper:generate"
        ],
        "lint": [
            "@lint:syntax",
            "@lint:rector",
            "@lint:mago",
            "@lint:pint",
            "composer normalize --dry-run",
            "@lint:js"
        ],
        "lint:fix": [
            "@lint:syntax",
            "composer normalize",
            "@lint:fix:rector",
            "@lint:fix:mago",
            "@lint:fix:pint",
            "@lint:fix:js"
        ],
        "lint:fix:js": [
            "@banner \"Lint JS Fix\" \"1;34\"",
            "bun run lintfix"
        ],
        "lint:fix:mago": [
            "@banner \"Lint Mago Fix\" \"1;31\"",
            "@php -r '$m = shell_exec(\"command -v mago 2>/dev/null\") ?: \"/usr/local/bin/mago\"; if (is_executable($m)) passthru(\"$m --config mago.toml lint --fix --baseline mago-lint-baseline.toml\"); else printf(\"Skipping mago lint --fix (not found)\\n\");' "
        ],
        "lint:fix:pint": [
            "@banner \"Pint Fix\" \"1;33\"",
            "@php vendor/bin/pint --parallel --dirty"
        ],
        "lint:fix:rector": [
            "@banner \"Rector Fix\" \"1;36\"",
            "@php vendor/bin/rector"
        ],
        "lint:js": [
            "@banner \"Lint JS\" \"1;93\"",
            "bun run lint"
        ],
        "lint:mago": [
            "@banner \"Lint Mago\" \"1;91\"",
            "@php -r '$m = shell_exec(\"command -v mago 2>/dev/null\") ?: \"/usr/local/bin/mago\"; if (is_executable($m)) passthru(\"$m --config mago.toml lint --baseline mago-lint-baseline.toml\"); else printf(\"Skipping mago lint (not found)\\n\");' "
        ],
        "lint:mago:pedantic": [
            "@banner \"Mago Pedantic Report\" \"1;35\"",
            "@php -r 'if (!is_dir(\"tmp\")) mkdir(\"tmp\"); $m = shell_exec(\"command -v mago 2>/dev/null\") ?: \"/usr/local/bin/mago\"; if (is_executable($m)) { passthru(\"$m --config mago.toml lint --pedantic >| tmp/lint-mago-pedantic-report.log 2>&1\"); printf(\"Report saved to tmp/lint-mago-pedantic-report.log\\n\"); } else printf(\"Skipping (not found)\\n\");' "
        ],
        "lint:pint": [
            "@banner \"Pint Dry-Run\" \"1;94\"",
            "@php vendor/bin/pint --parallel --dirty --test"
        ],
        "lint:rector": [
            "@banner \"Rector Dry-Run\" \"1;92\"",
            "@php vendor/bin/rector --dry-run"
        ],
        "lint:syntax": [
            "@banner \"Lint Syntax\" \"1;96\"",
            "@php vendor/bin/parallel-lint --no-progress --colors --show-deprecated app config database public resources routes tests"
        ],
        "local:ghaction:clean": [
            "@banner \"Clean Act Cache\" \"1;90\"",
            "@php -r '$cache = $_SERVER[\"HOME\"] . \"/.cache/act\"; if (is_dir($cache)) { printf(\"Clearing act cache...\\n\"); passthru(\"rm -rf $cache\"); } else printf(\"Act cache not found\\n\");' "
        ],
        "local:ghaction:quality:solo": [
            "@banner \"Quality Checks (Solo)\" \"1;97\"",
            "@php -r 'printf(\"Starting Solo with quality check commands...\\n\"); passthru(\"php artisan solo\");' "
        ],
        "log": [
            "@php -r 'require \"vendor/autoload.php\"; App\\Support\\Console\\Banner::log(array_slice($argv, 1));' -- "
        ],
        "mago:guard": [
            "@banner \"Mago Guard\" \"1;91\"",
            "@php -r '$m = shell_exec(\"command -v mago 2>/dev/null\") ?: \"/usr/local/bin/mago\"; if (is_executable($m)) passthru(\"$m --config mago.toml guard --baseline mago-guard-baseline.toml\"); else printf(\"Skipping mago guard (not found)\\n\");' "
        ],
        "mago:guard:fix": [
            "@banner \"Mago Guard Fix\" \"1;32\"",
            "@php -r '$m = shell_exec(\"command -v mago 2>/dev/null\") ?: \"/usr/local/bin/mago\"; if (is_executable($m)) passthru(\"$m guard --fix\"); else printf(\"Skipping mago guard --fix (not found)\\n\");' "
        ],
        "mago:list-files": [
            "@banner \"Mago List Files\" \"1;96\"",
            "@php -r '$m = shell_exec(\"command -v mago 2>/dev/null\") ?: \"/usr/local/bin/mago\"; if (is_executable($m)) passthru(\"$m list-files\"); else printf(\"Skipping mago list-files (not found)\\n\");' "
        ],
        "security:audit": [
            "@banner \"Security Audit\" \"7;1;91\"",
            "composer audit --locked || true"
        ],
        "setup": [
            "@banner \"Setup\" \"1;94\"",
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "test": "@test:core",
        "test:all": [
            "@test:core",
            "@test:heavy"
        ],
        "test:arch": [
            "@test:arch:full"
        ],
        "test:arch:full": [
            "@lint:syntax",
            "@test:arch:mago",
            "@test:arch:pest"
        ],
        "test:arch:mago": [
            "@mago:guard"
        ],
        "test:arch:pest": [
            "@banner \"Architecture Tests: Pest\" \"1;95\"",
            "@cache:clear:pest",
            "@php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" vendor/bin/pest --testsuite=Arch --cache-directory=.pest-cache"
        ],
        "test:behat": [
            "@banner \"Behat Tests\" \"1;36\"",
            "@lint:syntax",
            "@php vendor/bin/behat --config=behat.yml"
        ],
        "test:behat:api": [
            "@banner \"Behat API Tests\" \"1;34\"",
            "@lint:syntax",
            "@php vendor/bin/behat --config=behat.yml --suite=api"
        ],
        "test:behat:browser": [
