            "@lint:syntax",
            "@php vendor/bin/behat --config=behat.yml --suite=browser"
        ],
        "test:behat:watch": [
            "@php vendor/bin/behat --config=behat.yml --watch"
        ],
        "test:browser": [
            "@lint:syntax",
            "@test:browser:pest",
            "@test:browser:js"
        ],
        "test:browser-server": [
            "@php -r \"if (PHP_OS_FAMILY === 'Darwin') { exec('open -a \\\"Google Chrome\\\" --args --remote-debugging-port=9222 --headless 2>&1', \\$output, \\$return); } elseif (PHP_OS_FAMILY === 'Linux') { exec('google-chrome --remote-debugging-port=9222 --headless --no-sandbox --disable-dev-shm-usage 2>&1 &', \\$output, \\$return); } else { printf('Browser server setup not supported on this OS\\n'); exit(1); }\""
        ],
        "test:browser:js": [
            "@banner \"Browser Tests: JS\" \"1;35;47\"",
            "bun run test:browser 2>&1 || true"
        ],
        "test:browser:pest": [
            "@banner \"Browser Tests: Pest\" \"1;31;47\"",
            "rm -rf tests/Browser/Screenshots 2>/dev/null || true",
            "@cache:clear:pest",
            "@cache:clear:views",
            "@cache:clear:laravel",
            "@php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" vendor/bin/pest --testsuite=Browser"
        ],
        "test:core": [
            "@cache:clear:laravel",
            "@lint:fix",
            "@security:audit",
            "@test:arch:mago",
            "@test:profanity",
            "@test:type-coverage",
            "@test:unit",
            "@test:feature",
            "@test:coverage"
        ],
        "test:coverage": [
            "@lint:syntax",
            "@test:coverage:pcov",
            "@test:coverage:js"
        ],
        "test:coverage:js": [
            "@banner \"JS Coverage\" \"1;31\"",
            "LARAVEL_BYPASS_ENV_CHECK=1 bun run test:coverage 2>&1 || true"
        ],
        "test:coverage:pcov": [
            "@banner \"PHP Coverage (PCOV)\" \"1;35\"",
            "@php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d xdebug.mode=off -d pcov.enabled=1 vendor/bin/pest --coverage --min=99.4 2>&1 || true"
        ],
        "test:coverage:xdebug": [
            "@banner \"PHP Coverage (XDEBUG)\" \"1;95\"",
