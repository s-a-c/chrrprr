        "spatie/laravel-permission": "^6.24",
        "spatie/laravel-sluggable": "^3.7.5",
        "spatie/laravel-translatable": "^6.12",
        "stancl/tenancy": "^3.9.1",
        "staudenmeir/laravel-adjacency-list": "^1.25.2",
        "stevebauman/purify": "^6.3.1",
        "symfony/uid": "^7.4",
        "tightenco/parental": "^1.5.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16.3",
        "barryvdh/laravel-ide-helper": "^3.6.1",
        "behat/behat": "^3.29",
        "behat/gherkin": "^4.16.1",
        "behat/mink": "^1.13",
        "behat/mink-browserkit-driver": "^2.3",
        "behat/mink-extension": "^2.3",
        "cevinio/behat-laravel-extension": "^4.0",
        "dmore/behat-chrome-extension": "^1.4.1",
        "driftingly/rector-laravel": "^2.1.9",
        "ergebnis/composer-normalize": "^2.48.2",
        "fakerphp/faker": "^1.24.1",
        "infection/infection": "^0.31.9",
        "jasonmccreary/laravel-test-assertions": "^2.8",
        "larastan/larastan": "^3.8.1",
        "laravel-labs/starter-kit-browser-tests": "dev-main",
        "laravel-shift/blueprint": "^2.13",
        "laravel/boost": "^1.8.7",
        "laravel/pail": "^1.2.4",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.52",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.8.3",
        "peckphp/peck": "^0.2.0",
        "pestphp/pest": "^4.3.1",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-browser": "^4.1.1",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-profanity": "^4.2.1",
        "pestphp/pest-plugin-type-coverage": "^4.0.3",
        "php-parallel-lint/php-console-color": "^1.0.1",
        "php-parallel-lint/php-console-highlighter": "^1.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.33",
        "phpstan/phpstan-deprecation-rules": "^2.0.3",
        "phpstan/phpstan-phpunit": "^2.0.11",
        "phpstan/phpstan-strict-rules": "^2.0.7",
        "phpunit/phpunit": "^12.5.4",
        "psalm/plugin-laravel": "dev-master",
        "psalm/plugin-mockery": "dev-master",
        "psalm/plugin-phpunit": "dev-master",
        "rector/rector": "^2.3.0",
        "rector/type-perfect": "^2.1.1",
        "roave/security-advisories": "dev-latest",
        "soloterm/solo": "^0.5",
        "spatie/laravel-login-link": "^1.6.3",
        "spatie/laravel-missing-page-redirector": "^2.11.1",
        "spatie/laravel-queueable-action": "^2.16.2",
        "spatie/laravel-ray": "^1.43.2",
        "spatie/laravel-web-tinker": "^1.10.1",
        "spatie/pest-plugin-snapshots": "^2.2.1",
        "symfony/http-client": "^8.0.3",
        "vimeo/psalm": "^7.0@dev"
