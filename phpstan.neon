includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - phpstan-baseline.neon

parameters:

    treatPhpDocTypesAsCertain: false

    paths:
        - app
        - bootstrap
        # - config
        - database
        - public
        - resources
        - routes
        - tests

    excludePaths:
        - vendor
        - storage
        - tmp
        - node_modules
        - bootstrap/cache
        - tests/Pest.php
        - database/migrations

    level: max

    tmpDir: tmp/phpstan

    # Allow empty baseline and unmatched ignored errors
    # Set to false to suppress warnings about baseline entries that no longer match any errors
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        - '#ternary operator condition#'
        - '#does not accept string\|null#'
        - '#Dynamic call to static method Illuminate\\Session\\Store::flash\(\)#'
        - '#already int#'
        - '#specify its types: TKey, TModel#'
        - '#actually have it. Add more param types to get over 99 %#'
        - '#actually have it. Add more property types to get over 99 %#'
        - '#Only booleans are allowed in a negated boolean#'
        - '#does not accept mixed#'
        - '#does not do anything#'
        # Pest framework warnings
        - '#Ambiguous method call to.*on class Pest\\#'
        - '#Call to method.*of internal class Pest\\#'
        # Laravel Eloquent Builder dynamic methods
        - '#Ambiguous method call to.*on class Illuminate\\Database\\Eloquent\\Builder#'
        - '#Ambiguous property access.*on class Illuminate\\Database\\Eloquent\\Model#'
        - '#Ambiguous property access.*on class Illuminate\\Database\\Eloquent\\Collection#'
        # Laravel framework dynamic methods
        - '#Ambiguous method call to.*on class Illuminate\\Support\\Facades\\Route#'
        - '#Ambiguous method call to.*on class Illuminate\\Session\\SessionManager#'
        # PHPUnit/Pest internal class warnings
        - '#method\.internalClass#'
        - '#staticMethod\.dynamicCall#'
