===
{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/livewire-starter-kit",
    "type": "project",
    "description": "The official Laravel starter kit for Livewire.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": {
        "fluxui-pro": {
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        },
        "laravel-comments": {
            "type": "composer",
            "url": "https://satis.spatie.be"
        },
        "laravel-labs-starter-kit-browser-tests": {
            "type": "vcs",
            "url": "https://github.com/laravel-labs/starter-kit-browser-tests"
        },
        "psalm-plugin-laravel": {
            "type": "vcs",
            "url": "https://github.com/s-a-c/psalm-plugin-laravel"
        }
    },
    "require": {
        "php": "^8.5",
        "laravel/folio": "dev-master",
        "laravel/fortify": "^1.33",
        "laravel/framework": "^12.43.1",
        "laravel/tinker": "^2.10.2",
        "livewire/flux": "^2.10.2",
        "livewire/livewire": "^4.0@beta"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16.2",
        "barryvdh/laravel-ide-helper": "^3.6.1",
        "behat/behat": "^3.29",
        "behat/gherkin": "^4.16.1",
        "driftingly/rector-laravel": "^2.1.8",
        "ergebnis/composer-normalize": "^2.48.2",
        "fakerphp/faker": "^1.24.1",
        "infection/infection": "^0.31.9",
        "jasonmccreary/laravel-test-assertions": "^2.8",
        "larastan/larastan": "^3.8.1",
        "laravel-labs/starter-kit-browser-tests": "dev-main",
        "laravel-shift/blueprint": "^2.13",
        "laravel/boost": "^1.8.7",
        "laravel/pail": "^1.2.4",
        "laravel/pint": "^1.26",
        "laravel/sail": "^1.51",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.8.3",
        "pestphp/pest": "^4.2.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-browser": "^4.1.1",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-profanity": "^4.2.1",
        "pestphp/pest-plugin-type-coverage": "^4.0.3",
        "phpmd/phpmd": "^2.15",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.33",
        "phpstan/phpstan-deprecation-rules": "^2.0.3",
        "phpstan/phpstan-phpunit": "^2.0.11",
        "phpstan/phpstan-strict-rules": "^2.0.7",
        "phpunit/phpunit": "^12.5.3",
        "psalm/plugin-laravel": "dev-master",
        "psalm/plugin-mockery": "dev-master",
        "psalm/plugin-phpunit": "dev-master",
        "rector/rector": "^2.2.14",
        "rector/type-perfect": "^2.1.1",
        "roave/security-advisories": "dev-latest",
        "soloterm/solo": "^0.5",
        "spatie/laravel-login-link": "^1.6.3",
        "spatie/laravel-missing-page-redirector": "^2.11.1",
        "spatie/laravel-queueable-action": "^2.16.2",
        "spatie/laravel-ray": "^1.43.2",
        "spatie/laravel-web-tinker": "^1.10.1",
        "spatie/pest-plugin-snapshots": "^2.2.1",
        "vimeo/psalm": "^7.0@dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "scripts:list": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Scripts 2>/dev/null') ?: shell_exec('figlet Scripts 2>/dev/null') ?: 'Scripts' . PHP_EOL; echo chr(27) . '[1;34m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "@php -r \"\\$scripts = json_decode(file_get_contents('composer.json'), true)['scripts-descriptions'] ?? []; ksort(\\$scripts); foreach (\\$scripts as \\$name => \\$desc) { printf(chr(27) . '[1;32m%-20s' . chr(27) . '[0m %s' . PHP_EOL, \\$name, \\$desc); }\""
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Dev\\ Server 2>/dev/null') ?: shell_exec('figlet Dev\\ Server 2>/dev/null') ?: 'Dev Server' . PHP_EOL; echo chr(27) . '[1;36;47m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "solo": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Solo 2>/dev/null') ?: shell_exec('figlet Solo 2>/dev/null') ?: 'Solo' . PHP_EOL; echo chr(27) . '[1;36;47m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "Composer\\Config::disableProcessTimeout",
            "php artisan solo"
        ],
        "lint": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Lint 2>/dev/null') ?: shell_exec('figlet Lint 2>/dev/null') ?: 'Lint' . PHP_EOL; echo chr(27) . '[7;1;35m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "@lint:composer",
            "@lint:arch",
            "@lint:rector",
            "@lint:phpstan",
            "@lint:psalm",
            "@lint:mago",
            "@lint:phpmd",
            "@lint:pint",
            "@lint:js"
        ],
        "lint:fix": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Lint\\ Fix 2>/dev/null') ?: shell_exec('figlet Lint\\ Fix 2>/dev/null') ?: 'Lint Fix' . PHP_EOL; echo chr(27) . '[1;32m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "@lint:composer:fix",
            "@lint:rector:fix",
            "@lint:arch:fix",
            "@lint:phpstan:fix",
            "@lint:psalm:fix",
            "@lint:mago:fix",
            "@lint:pint:fix",
            "@lint:js:fix"
        ],
        "lint:arch": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Arch\\ Check 2>/dev/null') ?: shell_exec('figlet Arch\\ Check 2>/dev/null') ?: 'Arch Check' . PHP_EOL; echo chr(27) . '[1;36m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "command -v mago >/dev/null 2>&1 && mago guard || (echo 'Skipping mago guard (mago not installed)' && exit 0)",
            "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G vendor/bin/pest --testsuite=Arch"
        ],
        "lint:arch:fix": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Arch\\ Fix 2>/dev/null') ?: shell_exec('figlet Arch\\ Fix 2>/dev/null') ?: 'Arch Fix' . PHP_EOL; echo chr(27) . '[1;32m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "command -v mago >/dev/null 2>&1 && mago guard --fix || (echo 'Skipping mago guard --fix (mago not installed)' && exit 0)"
        ],
        "lint:composer": [
            "composer normalize --dry-run --no-update-lock || true"
        ],
        "lint:composer:fix": [
            "composer normalize"
        ],
        "lint:js": [
            "bun run lint"
        ],
        "lint:js:fix": [
            "bun run lint:fix"
        ],
        "lint:mago": [
            "command -v mago >/dev/null 2>&1 && mago lint --baseline mago-lint-baseline.toml || (echo 'Skipping mago lint (mago not installed)' && exit 0)",
            "command -v mago >/dev/null 2>&1 && mago format --check || (echo 'Skipping mago format check (mago not installed)' && exit 0)",
            "command -v mago >/dev/null 2>&1 && mago analyze --baseline mago-analysis-baseline.toml || (echo 'Skipping mago analyze (mago not installed)' && exit 0)"
        ],
        "lint:mago:fix": [
            "command -v mago >/dev/null 2>&1 && mago lint --fix --baseline mago-lint-baseline.toml || (echo 'Skipping mago lint --fix (mago not installed)' && exit 0)",
            "command -v mago >/dev/null 2>&1 && mago format || (echo 'Skipping mago format (mago not installed)' && exit 0)",
            "command -v mago >/dev/null 2>&1 && mago analyze --fix --baseline mago-analysis-baseline.toml || (echo 'Skipping mago analyze --fix (mago not installed)' && exit 0)"
        ],
        "phpmd": [
            "vendor/bin/phpmd app,config,database,routes text rulesets.xml || echo 'PHPMD: rulesets.xml not found, using default' && vendor/bin/phpmd app,config,database,routes text cleancode,codesize,controversial,design,naming,unusedcode"
        ],
        "lint:phpmd": [
            "@phpmd"
        ],
        "lint:pint": [
            "php -d memory_limit=1G vendor/bin/pint --parallel --test"
        ],
        "lint:pint:fix": [
            "php -d memory_limit=1G vendor/bin/pint --parallel"
        ],
        "lint:phpstan": [
            "php -d memory_limit=1G vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "lint:phpstan:fix": [
            "php -d memory_limit=1G vendor/bin/phpstan analyse --memory-limit=1G --fix || true"
        ],
        "lint:psalm": [
            "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G vendor/bin/psalm --no-cache"
        ],
        "lint:psalm:fix": [
            "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G vendor/bin/psalm --no-cache --alter --issues=all || true"
        ],
        "lint:rector": [
            "php -d memory_limit=1G vendor/bin/rector --dry-run"
        ],
        "lint:rector:fix": [
            "php -d memory_limit=1G vendor/bin/rector"
        ],
        "test": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Test\\ Suite 2>/dev/null') ?: shell_exec('figlet Test\\ Suite 2>/dev/null') ?: 'Test Suite' . PHP_EOL; echo chr(27) . '[1;37;44m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "@php artisan config:clear --ansi",
            "@lint",
            "@test:types",
            "@test:unit",
            "@security:audit"
        ],
        "test:unit": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Unit\\ Tests 2>/dev/null') ?: shell_exec('figlet Unit\\ Tests 2>/dev/null') ?: 'Unit Tests' . PHP_EOL; echo chr(27) . '[1;34;47m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G -d xdebug.mode=off -d pcov.enabled=1 vendor/bin/pest --testsuite=Unit,Feature --coverage --min=99"
        ],
        "test:types": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Type\\ Coverage 2>/dev/null') ?: shell_exec('figlet Type\\ Coverage 2>/dev/null') ?: 'Type Coverage' . PHP_EOL; echo chr(27) . '[7;1;36m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G vendor/bin/pest --type-coverage --min=100"
        ],
        "test:browser": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Browser\\ Tests 2>/dev/null') ?: shell_exec('figlet Browser\\ Tests 2>/dev/null') ?: 'Browser Tests' . PHP_EOL; echo chr(27) . '[1;36;47m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "composer starter-kit-browser-tests"
        ],
        "starter-kit-browser-tests": [
             "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G vendor/bin/pest --configuration=phpunit.xml.starter-kit-browser || echo 'Browser tests failed or configuration missing'"
        ],
        "behat": [
            "vendor/bin/behat"
        ],
        "gherkin": [
            "@behat --dry-run"
        ],
        "test:mutation": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Mutation\\ Tests 2>/dev/null') ?: shell_exec('figlet Mutation\\ Tests 2>/dev/null') ?: 'Mutation Tests' . PHP_EOL; echo chr(27) . '[1;33;46m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "@infection"
        ],
        "infection": [
            "PEST_MUTATE=1 php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G vendor/bin/pest --mutate --parallel --min=90 --covered-only --default-time-limit=10"
        ],
        "test:profanity": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Profanity\\ Check 2>/dev/null') ?: shell_exec('figlet Profanity\\ Check 2>/dev/null') ?: 'Profanity Check' . PHP_EOL; echo chr(27) . '[1;31m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" -d memory_limit=1G vendor/bin/pest --filter=profanity"
        ],
        "test:all": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Full\\ Suite 2>/dev/null') ?: shell_exec('figlet Full\\ Suite 2>/dev/null') ?: 'Full Suite' . PHP_EOL; echo chr(27) . '[1;37;44m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "@test",
            "@test:browser",
            "@test:mutation",
            "@test:profanity"
        ],
        "generate:blueprint": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Blueprint 2>/dev/null') ?: shell_exec('figlet Blueprint 2>/dev/null') ?: 'Blueprint' . PHP_EOL; echo chr(27) . '[1;34m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "php artisan blueprint:build"
        ],
        "generate:ide-helper": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard IDE\\ Helper 2>/dev/null') ?: shell_exec('figlet IDE\\ Helper 2>/dev/null') ?: 'IDE Helper' . PHP_EOL; echo chr(27) . '[1;33m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "php artisan ide-helper:generate"
        ],
        "ide-helper": [
            "@generate:ide-helper"
        ],
        "security:audit": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Security\\ Audit 2>/dev/null') ?: shell_exec('figlet Security\\ Audit 2>/dev/null') ?: 'Security Audit' . PHP_EOL; echo chr(27) . '[7;1;33m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "composer audit --locked || true"
        ],
        "update:reqs": [
            "php -r \"\\$banner = shell_exec('figlet -w 120 -k -f standard Update\\ Reqs 2>/dev/null') ?: shell_exec('figlet Update\\ Reqs 2>/dev/null') ?: 'Update Reqs' . PHP_EOL; echo chr(27) . '[1;35m' . \\$banner . chr(27) . '[0m' . PHP_EOL;\"",
            "composer bump",
            "bunx npm-check-updates -u"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "scripts-descriptions": {
        "scripts:list": "List all available scripts and their descriptions",
        "setup": "Initial project setup (env, key, migrate, bun install/build)",
        "dev": "Start the full development environment (server, queue, logs, vite)",
        "solo": "Start the development environment using Laravel Solo",
        "lint": "Run all code quality checks (composer, rector, phpstan, psalm, mago, phpmd, pint, js)",
        "lint:fix": "Automatically fix code quality issues where possible",
        "lint:arch": "Check architectural consistency and Mago guards",
        "lint:arch:fix": "Fix architectural issues using Mago guard --fix",
        "lint:composer": "Check composer.json normalization",
        "lint:composer:fix": "Normalize composer.json",
        "lint:js": "Lint JavaScript resources using Prettier",
        "lint:js:fix": "Fix JavaScript linting issues using Prettier",
        "lint:mago": "Run Mago lint, format check, and analysis",
        "lint:mago:fix": "Fix Mago issues (lint, format, analyze)",
        "lint:pint": "Run Laravel Pint style checks",
        "lint:pint:fix": "Fix Laravel Pint style issues",
        "lint:phpstan": "Run PHPStan static analysis",
        "lint:phpstan:fix": "Try to fix PHPStan issues automatically",
        "lint:psalm": "Run Psalm static analysis",
        "lint:psalm:fix": "Try to fix Psalm issues automatically",
        "lint:rector": "Run Rector checks (dry-run)",
        "lint:rector:fix": "Apply Rector refactorings",
        "phpmd": "Run PHP Mess Detector analysis",
        "lint:phpmd": "Alias for phpmd",
        "behat": "Run Behat behavior tests",
        "gherkin": "Check Gherkin feature files (dry-run behat)",
        "test": "Run the standard test suite including linting and type coverage",
        "test:unit": "Run PHP unit and feature tests with Pest",
        "test:types": "Check PHP type coverage with Pest",
        "test:browser": "Run browser tests with Playwright and Pest",
        "starter-kit-browser-tests": "Alias for test:browser",
        "test:mutation": "Run mutation tests with Infection via Pest",
        "infection": "Alias for test:mutation",
        "test:profanity": "Check for profanity in the codebase",
        "test:all": "Run EVERYTHING (lint, tests, browser, mutation, profanity)",
        "generate:blueprint": "Build Blueprint starters",
        "generate:ide-helper": "Generate IDE helper files",
        "ide-helper": "Alias for generate:ide-helper",
        "composer-normalize": "Alias for lint:composer",
        "security:audit": "Check Composer dependencies for security vulnerabilities",
        "update:reqs": "Update Composer and NPM version requirements"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
```


## Conclusion

The scripts are now logically organized, deduplicated, and fully documented, making the codebase more approachable for developers.
